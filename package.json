{
  "name": "phyllon-project",
  "version": "1.0.0",
  "private": true,
  "description": "Phyllon reading app: Vite frontend and Express backend",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "start": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run preview\" \"npm --prefix backend start\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.2.11"
  }
}

