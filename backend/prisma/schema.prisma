generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  colors      String[] // Array of gradient hex color strings
  moods       String[] // Array of moods (e.g. ["Haunted", "Wistful"])
  description String
  pageCount   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


